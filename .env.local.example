# ============================================================================
# CodeCraft Studio — Environment Configuration
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` must NEVER be committed to version control.
# ============================================================================

# --- Core ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=YOUR_RANDOM_32_BYTE_HEX_SECRET

# MongoDB Atlas connection string (replace with your cluster URI)
MONGODB_URI=mongodb+srv://<dbuser>:<dbpassword>@cluster0.xxxxx.mongodb.net/codecraft-studio

# --- OAuth providers (optional — leave blank to hide buttons) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI Coding Assistant (Gemini preferred, Groq fallback) ---
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# --- Secure Code Execution Sandbox ---
# Default points at the public Piston sandbox API (isolated containers).
# For full isolation, self-host Piston or Judge0 CE and point this URL at it.
PISTON_API_URL=https://emkc.org/api/v2/piston
SANDOX_TIMEOUT_MS=5000

# --- Seed script defaults (npm run seed) ---
ADMIN_EMAIL=admin@codecraft.dev
ADMIN_PASSWORD=ChangeMe123!